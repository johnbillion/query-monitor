{
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"allowJs": true,
		"noImplicitAny": true,
		"module": "ESNext",
		"moduleResolution": "node",
		"target": "ES2020",
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"baseUrl": ".",
		"paths": {
			"react": ["./node_modules/preact/compat/"],
			"react-dom": ["./node_modules/preact/compat/"]
		}
	},
	"exclude": [
		"build",
		"node_modules",
		"tests",
		"vendor"
	]
}
