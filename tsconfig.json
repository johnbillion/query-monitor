{
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"allowJs": true,
		"noImplicitAny": true,
		"module": "ESNext",
		"moduleResolution": "node",
		"target": "ES2020",
		"jsx": "react"
	},
	"exclude": [
		"build",
		"node_modules",
		"tests",
		"vendor"
	]
}
