{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://schemas.querymonitor.com/src/schemas/backtrace.json",
	"title": "Backtrace",
	"description": "Class representing a backtrace.",
	"type": "object",
	"required": [
		"component",
		"frames",
		"time"
	],
	"properties": {
		"component": {
			"phpType": "QM_Component",
			"type": "object",
			"allOf": [
				{
					"$ref": "./component.json"
				}
			]
		},
		"callsite": {
			"phpType": "QM_Data_Callsite",
			"oneOf": [
				{
					"$ref": "./callsite.json"
				},
				{
					"type": "null"
				}
			]
		},
		"frames": {
			"type": "array",
			"items": {
				"type": "object",
				"allOf": [
					{
						"$ref": "./stack-frame.json"
					}
				]
			}
		},
		"time": {
			"description": "Time in milliseconds relative to the start of the request.",
			"type": "number"
		}
	},
	"additionalProperties": false
}
