{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"lib": ["ES2020"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "Node16",
		"types": ["@playwright/test", "node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
